# Database (Prisma SQLite local)
DATABASE_URL="file:./prisma/dev.db"

# Supabase (production — optional for local MVP)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Kakao Map — JavaScript 키 (REST API 키 아님). docs/KAKAO_MAP.md 참고
# 로컬 지도: 키 설정 + DISABLE_MAP 미설정 → 카카오맵 표시
NEXT_PUBLIC_KAKAO_MAP_KEY=

# 카카오 로컬 REST API 키 — 사이드바 센터 썸네일(장소 검색 첫 사진). 서버 전용, git에 올리지 않음
KAKAO_REST_API_KEY=

# (선택) 로컬만 지도 끄기 — 맥이 느릴 때만 1 로 설정. Vercel에는 넣지 마세요.
# NEXT_PUBLIC_DISABLE_MAP=1

# Admin (simple bearer for MVP)
ADMIN_SECRET=change-me-in-production
